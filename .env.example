# Development and CI only (docs/OPERATIONS.md). `pnpm run setup` copies this file to .env and replaces every
# __SECRET_<NAME>__ marker with a random value generated on your machine. No value here is a real credential,
# and .env is never committed. Staging and production secrets live only on their servers.

NODE_ENV=development
APP_ENV=development
APP_ROLE=api
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
SEED_ALLOWED=true
OTEL_SERVICE_NAME=hakorem-api
OTEL_TRACES_SAMPLER_ARG=1

# Host ports for the Docker Compose stack, bound to 127.0.0.1. If you change one, change the URLs below to match.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=3000

# Read by docker-compose.yml.
POSTGRES_PASSWORD=__SECRET_POSTGRES__
REDIS_PASSWORD=__SECRET_REDIS__
HK_APP_PASSWORD=__SECRET_HK_APP__

# The superuser, used only by `pnpm db:bootstrap` to create the roles. Never present on a server.
DATABASE_URL_ADMIN=postgres://postgres:__SECRET_POSTGRES__@127.0.0.1:55432/postgres
# One connection per database role (ADR-0024).
DATABASE_URL_MIGRATOR=postgres://hk_migrator:__SECRET_HK_MIGRATOR__@127.0.0.1:55432/hakorem
DATABASE_URL_APP=postgres://hk_app:__SECRET_HK_APP__@127.0.0.1:55432/hakorem
DATABASE_URL_WORKER=postgres://hk_worker:__SECRET_HK_WORKER__@127.0.0.1:55432/hakorem
DATABASE_URL_SEALER=postgres://hk_sealer:__SECRET_HK_SEALER__@127.0.0.1:55432/hakorem
DATABASE_URL_REPORT=postgres://hk_report:__SECRET_HK_REPORT__@127.0.0.1:55432/hakorem
DATABASE_URL_BACKUP=postgres://hk_backup:__SECRET_HK_BACKUP__@127.0.0.1:55432/hakorem

REDIS_URL=redis://:__SECRET_REDIS__@127.0.0.1:56379/0
HK_WORKER_PASSWORD=__SECRET_HK_WORKER__
HK_SEALER_PASSWORD=__SECRET_HK_SEALER__
# Every key in the process's Redis namespace starts with this.
REDIS_KEY_PREFIX=hk:

# Browser origins allowed to call the API with cookies: the console (Vite) and the storefront (Next.js), locally.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001,http://localhost:4173

# Encryption keys (ADR-0022): base64 of 32 random bytes, generated here; staging and production keys live only on
# their servers.
KEK_ACTIVE_VERSION=1
KEK_V1=__KEY32_KEK_V1__
LOOKUP_HMAC_KEY=__KEY32_LOOKUP__

# Access tokens (ADR-0016): an Ed25519 private key per key id, base64 of PKCS#8 DER (PEM is accepted too).
JWT_ACTIVE_KEY_ID=dev-1
JWT_SIGNING_KEYS='{"dev-1":"__ED25519_JWT__"}'
# The breached-password range query calls an outside service; off locally, the bundled list still applies.
HIBP_ENABLED=false

# Object storage (docs/OPERATIONS.md section 3.5): Versity Gateway in Docker locally (ADR-0032).
OBJECT_STORE_HOST_PORT=57070
S3_ENDPOINT=http://127.0.0.1:57070
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=hkdev__SECRET_S3_ACCESS__
S3_SECRET_ACCESS_KEY=__SECRET_S3_SECRET__
S3_BUCKET_PUBLIC_MEDIA=hakorem-dev-media
S3_BUCKET_PRIVATE=hakorem-dev-private
S3_BUCKET_ANCHORS=hakorem-dev-anchors
S3_ANCHOR_ACCESS_KEY_ID=hkdev__SECRET_S3_ACCESS__
S3_ANCHOR_SECRET_ACCESS_KEY=__SECRET_S3_SECRET__

# The audit anchor's signing key (ADR-0006): the worker only.
AUDIT_ANCHOR_KEY_ID=dev-anchor-1
AUDIT_ANCHOR_SIGNING_KEY=__ED25519_ANCHOR__

# The seeded staff's password, generated per machine (src/seed/farm-b3.ts). Read it here; it is never printed.
SEED_STAFF_PASSWORD=__SECRET_SEED_STAFF__
