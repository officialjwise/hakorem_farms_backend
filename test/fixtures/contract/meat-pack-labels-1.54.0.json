    "printPackLabels": {
      "operationId": "printPackLabels",
      "tags": [
        "prc"
      ],
      "summary": "Print pack labels: the data each label carries, with its lot and weight barcode",
      "description": "Answers what each label prints, for the client to draw (A-151): product, batch, production and expiry dates, storage class, the weight in kilograms and a CODE_128 barcode whose payload is the lot and the weight in grams (`PRC-261114-3f2a91c4-01/015000`). The first print time is recorded once; a reprint gives the same payload and is marked `reprint`. Only packs IN_STOCK or PICKED print.\n\nRefusals (422 PROCESSING_ORDER_INVALID): ORDER_NOT_COMPLETED, NO_PACKS, TOO_MANY_PACKS, PACK_NOT_IN_ORDER, PACK_NOT_IN_STOCK.\n\nPermission: `prc.order.process`, scoped to the order's branch and processing location.",
      "x-permission": "prc.order.process",
      "x-error-codes": [
        "VALIDATION_FAILED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "PASSWORD_CHANGE_REQUIRED",
        "CSRF_TOKEN_INVALID",
        "ORIGIN_NOT_ALLOWED",
        "IDEMPOTENCY_KEY_REQUIRED",
        "IDEMPOTENCY_KEY_REUSED",
        "NOT_FOUND",
        "PROCESSING_ORDER_INVALID",
        "RATE_LIMITED"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "$ref": "#/components/parameters/IdempotencyKey"
        },
        {
          "$ref": "#/components/parameters/CsrfToken"
        }
      ],
      "security": [
        {
          "staffSession": []
        },
        {
          "apiKey": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LabelPrintRequest"
            },
            "example": {
